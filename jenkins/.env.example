# JCasC substitutes these ${VARS} into casc.yaml at startup.
# Every variable must be set: the controller refuses its config otherwise.

# Admin account (created by JCasC on first boot)
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me-strong

JENKINS_PORT=8080

# Public URL (used for email links + the GitHub webhook endpoint)
# Local:  http://localhost:8080/
JENKINS_URL=http://localhost:8080/

# Notifications
NOTIFY_EMAIL=you@example.com
SMTP_USERNAME=you@gmail.com
SMTP_APP_PASSWORD=your16charapppassword

# Git host access (read-only PAT)
GIT_USERNAME=your-git-username
GIT_TOKEN=your-read-only-token

# SSH key pair the controller uses to launch the agents.
#   ssh-keygen -t ed25519 -N "" -C jenkins-agent -f ~/.ssh/jenkins_agent
# Private key, base64-encoded so it fits on one line (controller side):
#   base64 < ~/.ssh/jenkins_agent | tr -d '\n'
AGENT_SSH_KEY_B64=
# Public key, as is (agent side: written to authorized_keys):
#   cat ~/.ssh/jenkins_agent.pub
AGENT_SSH_PUBKEY=

# The app's own .env (the one compose.yml reads), base64-encoded on one line.
# The pipeline gets it as the "ecommerce-env" credential to deploy with.
#   base64 -w0 app.env      (on macOS: base64 < app.env | tr -d '\n')
APP_ENV_B64=
